rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated (admin)
    function isAdmin() {
      return request.auth != null;
    }

    // Public read access for portfolio data, admin-only write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /timeline/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /globals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for any other collections to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
